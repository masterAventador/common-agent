# 本机共享端口。启动前仍须检查冲突。
COMMON_AGENT_API_HOST=127.0.0.1
COMMON_AGENT_API_PORT=18200
# 仅信任本机反向代理写入的 Forwarded 标头，禁止客户端自行伪造来源地址。
COMMON_AGENT_TRUSTED_PROXY_IPS=127.0.0.1
COMMON_AGENT_WEB_HOST=127.0.0.1
COMMON_AGENT_WEB_PORT=18280
COMMON_AGENT_CORS_ORIGINS=http://127.0.0.1:18280
# real 使用 RAGFlow/Deep Agents/百炼；demo 使用固定适配器且页面显式标记演示模式。
COMMON_AGENT_INTEGRATION_MODE=real
# 首位管理员仅可创建一次；本机统一入口默认使用 Git 忽略的 0600 项目专属文件。
COMMON_AGENT_AUTH_BOOTSTRAP_TOKEN=
COMMON_AGENT_AUTH_SESSION_IDLE_SECONDS=1800
COMMON_AGENT_AUTH_SESSION_ABSOLUTE_SECONDS=43200
COMMON_AGENT_AUTH_LOGIN_WINDOW_SECONDS=900
COMMON_AGENT_AUTH_LOGIN_MAX_ATTEMPTS=5
COMMON_AGENT_AUTH_COOKIE_SECURE=false
# 审计记录不自动删除；达到单作用域硬上限时，受审计的成功请求关闭失败。
COMMON_AGENT_AUDIT_RETENTION_DAYS=365
COMMON_AGENT_AUDIT_MAX_EVENTS_PER_SCOPE=1000000
# 本机未配置时使用仅限开发的固定密钥；正式环境必须在 secrets.env 提供 32 字节 Base64 密钥环。
COMMON_AGENT_TOOL_CREDENTIAL_KEYS=
COMMON_AGENT_TOOL_CREDENTIAL_ACTIVE_KEY_ID=
# RAGFlow 技术租户 Token 与账号密码派生使用另一套独立密钥环；正式环境必须显式提供。
COMMON_AGENT_RAGFLOW_IDENTITY_KEYS=
COMMON_AGENT_RAGFLOW_IDENTITY_ACTIVE_KEY_ID=
# MCP 出站只允许精确主机或显式 CIDR；不支持通配域名、系统代理或自动重定向。
COMMON_AGENT_TOOL_EGRESS_ALLOWED_HOSTS=localhost
COMMON_AGENT_TOOL_EGRESS_ALLOWED_CIDRS=127.0.0.0/8,::1/128
COMMON_AGENT_TOOL_EGRESS_HTTP_ALLOWED_HOSTS=localhost
COMMON_AGENT_TOOL_EGRESS_ALLOW_LOOPBACK=true
COMMON_AGENT_TOOL_EGRESS_CONNECT_TIMEOUT_SECONDS=5
COMMON_AGENT_TOOL_EGRESS_READ_TIMEOUT_SECONDS=30
COMMON_AGENT_TOOL_EGRESS_CALL_TIMEOUT_SECONDS=60
COMMON_AGENT_TOOL_EGRESS_MAX_RESPONSE_BYTES=1048576
COMMON_AGENT_TOOL_EGRESS_MAX_CONCURRENCY=16
RAGFLOW_BASE_URL=http://127.0.0.1:19380
RAGFLOW_WEB_URL=http://127.0.0.1:19381
RAGFLOW_EXPECTED_VERSION=v0.26.4
RAGFLOW_EMBEDDING_MODEL=text-embedding-v4@common-agent-embedding@OpenAI-API-Compatible
RAGFLOW_RERANK_MODEL=qwen3-rerank@common-agent-rerank@OpenAI-API-Compatible
RAGFLOW_TIMEOUT_SECONDS=60
RAGFLOW_BAILIAN_MIGRATION_TIMEOUT_SECONDS=3600
RAGFLOW_BAILIAN_MIGRATION_DATASET_IDS=
RAGFLOW_CONFIRM_BAILIAN_REINDEX=

# 平台自有 MySQL，只绑定本机 loopback；与 RAGFlow 内部 MySQL 完全隔离。
COMMON_AGENT_DATABASE_URL=mysql+aiomysql://common_agent:common_agent_dev@127.0.0.1:19506/common_agent?charset=utf8mb4

# 真实值只放在被 .gitignore 排除的本机环境文件中。
RAGFLOW_API_KEY=

# 阿里百炼。开发默认读取 backend/.env.demo，环境变量会覆盖其中配置。
BAILIAN_MODEL=
BAILIAN_BASE_URL=
BAILIAN_API_KEY=
BAILIAN_TIMEOUT_SECONDS=60
BAILIAN_STREAM_CHUNK_TIMEOUT_SECONDS=60
BAILIAN_MAX_RETRIES=2
