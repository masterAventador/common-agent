# 本机共享端口。启动前仍须检查冲突。
COMMON_AGENT_API_HOST=127.0.0.1
COMMON_AGENT_API_PORT=18200
COMMON_AGENT_WEB_HOST=127.0.0.1
COMMON_AGENT_WEB_PORT=18280
COMMON_AGENT_CORS_ORIGINS=http://127.0.0.1:18280
RAGFLOW_BASE_URL=http://127.0.0.1:19380
RAGFLOW_WEB_URL=http://127.0.0.1:19381
RAGFLOW_EXPECTED_VERSION=v0.25.6
RAGFLOW_TIMEOUT_SECONDS=60

# 留空时使用仓库 .local/common-agent.db；切换正式适配器时取消注释并填写。
# COMMON_AGENT_DATABASE_URL=postgresql+asyncpg://common-agent:password@127.0.0.1:19432/common_agent

# 真实值只放在被 .gitignore 排除的本机环境文件中。
RAGFLOW_API_KEY=

# 阿里百炼。开发默认可读取 backend/.env.demo，环境变量会覆盖 Demo 值。
BAILIAN_MODEL=
BAILIAN_BASE_URL=
BAILIAN_API_KEY=
