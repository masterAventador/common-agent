ARG RAGFLOW_FORK_IMAGE_BASE=infiniflow/ragflow:v0.26.4
FROM ${RAGFLOW_FORK_IMAGE_BASE}

ARG RAGFLOW_FORK_IMAGE_BASE
ARG RAGFLOW_FORK_IMAGE_REVISION
ARG RAGFLOW_FORK_IMAGE_SOURCE
ARG RAGFLOW_FORK_IMAGE_BASE_DIGEST

LABEL org.opencontainers.image.revision="${RAGFLOW_FORK_IMAGE_REVISION}" \
      org.opencontainers.image.source="${RAGFLOW_FORK_IMAGE_SOURCE}" \
      org.opencontainers.image.base.name="${RAGFLOW_FORK_IMAGE_BASE}" \
      com.common-agent.ragflow.base.digest="${RAGFLOW_FORK_IMAGE_BASE_DIGEST}"

# 补丁集的生产源码只位于 api/ 与 rag/；docker/ 配置由同一 submodule 的 Compose 直接消费。
# 覆盖完整目录而不是维护易漏文件清单，依赖环境和前端仍精确复用已审阅的官方固定镜像。
COPY api /ragflow/api
COPY rag /ragflow/rag
