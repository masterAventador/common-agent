# 非敏感配置；凭据请写入权限为 0600 的 secrets.env。
COMMON_AGENT_INTEGRATION_MODE=real
COMMON_AGENT_CORS_ORIGINS=https://agent.example.com
# 正式 Compose 由私有 Edge 覆盖为 *；不要把 API 端口直接暴露到宿主机。
COMMON_AGENT_TRUSTED_PROXY_IPS=*
COMMON_AGENT_AUTH_COOKIE_SECURE=true
COMMON_AGENT_AUTH_SESSION_IDLE_SECONDS=1800
COMMON_AGENT_AUTH_SESSION_ABSOLUTE_SECONDS=43200
# 精确主机许可；内网目标还必须落在显式 CIDR 中。HTTP 主机默认不放行。
COMMON_AGENT_TOOL_EGRESS_ALLOWED_HOSTS=mcp.vendor.example,business-api.internal.example
COMMON_AGENT_TOOL_EGRESS_ALLOWED_CIDRS=10.20.0.0/16
COMMON_AGENT_TOOL_EGRESS_HTTP_ALLOWED_HOSTS=
COMMON_AGENT_TOOL_EGRESS_ALLOW_LOOPBACK=false
COMMON_AGENT_TOOL_EGRESS_CONNECT_TIMEOUT_SECONDS=5
COMMON_AGENT_TOOL_EGRESS_READ_TIMEOUT_SECONDS=30
COMMON_AGENT_TOOL_EGRESS_CALL_TIMEOUT_SECONDS=60
COMMON_AGENT_TOOL_EGRESS_MAX_RESPONSE_BYTES=1048576
COMMON_AGENT_TOOL_EGRESS_MAX_CONCURRENCY=16
RAGFLOW_BASE_URL=https://ragflow.internal.example:9443
RAGFLOW_CA_BUNDLE=/run/common-agent/tls/ca-bundle.crt
RAGFLOW_EXPECTED_VERSION=v0.26.4
RAGFLOW_EMBEDDING_MODEL=text-embedding-v4@common-agent-embedding@OpenAI-API-Compatible
RAGFLOW_RERANK_MODEL=qwen3-rerank@common-agent-rerank@OpenAI-API-Compatible
RAGFLOW_TIMEOUT_SECONDS=120
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen3-max

# secrets.env 示例键名（不要把真实值提交到 Git）：
# MYSQL_ROOT_PASSWORD=<random>
# MYSQL_DATABASE=common_agent
# MYSQL_USER=common_agent
# MYSQL_PASSWORD=<random>
# COMMON_AGENT_DATABASE_URL=mysql+aiomysql://common_agent:<url-encoded-password>@platform-mysql:3306/common_agent?charset=utf8mb4
# COMMON_AGENT_AUTH_BOOTSTRAP_TOKEN=<32-256 characters>
# COMMON_AGENT_TOOL_CREDENTIAL_KEYS=v1:<base64-encoded-32-byte-key>
# COMMON_AGENT_TOOL_CREDENTIAL_ACTIVE_KEY_ID=v1
# COMMON_AGENT_RAGFLOW_IDENTITY_KEYS=v1:<base64-encoded-32-byte-key>
# COMMON_AGENT_RAGFLOW_IDENTITY_ACTIVE_KEY_ID=v1
# RAGFLOW_API_KEY=<legacy default-workspace ragflow token; empty after a fresh install>
# BAILIAN_API_KEY=<bailian key>
