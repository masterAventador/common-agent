        "id",
        "workflow_id",
        "trigger",
        "status",
        "input",
        "output",
        "current_node_id",
        "completed_node_ids",
        "failed_node_id",
        "error_code",
        "origin",
        "ai_targets",
        "created_at",
        "started_at",
        "finished_at",
        "updated_at"
