    "WorkflowRunOriginResponse": {
      "additionalProperties": false,
      "properties": {
        "assistant_message_id": {
          "format": "uuid",
          "title": "Assistant Message Id",
          "type": "string"
        },
        "conversation_id": {
          "format": "uuid",
          "title": "Conversation Id",
          "type": "string"
