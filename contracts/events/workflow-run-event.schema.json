      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "run": {
      "$ref": "#/$defs/WorkflowRunResponse"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "title": "Sequence",
      "type": "integer"
    },
    "type": {
      "$ref": "#/$defs/WorkflowEventKind"
    },
    "workflow_id": {
      "format": "uuid",
      "title": "Workflow Id",
      "type": "string"
    }
