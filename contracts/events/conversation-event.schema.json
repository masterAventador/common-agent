  "additionalProperties": false,
  "properties": {
    "conversation_id": {
      "format": "uuid",
      "title": "Conversation Id",
      "type": "string"
    },
    "delta": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Delta"
    },
    "message": {
      "$ref": "#/$defs/MessageResponse"
    },
    "message_id": {
      "format": "uuid",
      "title": "Message Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "retry": {
      "title": "Retry",
      "type": "boolean"
    },
    "schema_version": {
      "const": "2",
      "default": "2",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "title": "Sequence",
      "type": "integer"
    },
    "tool_call": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolCallEventResponse"
        },
        {
          "type": "null"
        }
      ]
    },
    "turn_id": {
      "format": "uuid",
      "title": "Turn Id",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/ConversationEventKind"
    }
