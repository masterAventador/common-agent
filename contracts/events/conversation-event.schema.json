  "required": [
    "sequence",
    "conversation_id",
    "turn_id",
    "message_id",
    "type",
    "delta",
    "retry",
    "tool_call",
    "message",
    "occurred_at"
  ],
  "title": "ConversationEventResponse",
  "type": "object"
}
