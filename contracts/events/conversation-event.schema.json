        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "document_name": {
          "title": "Document Name",
          "type": "string"
        },
        "knowledge_base_id": {
          "title": "Knowledge Base Id",
          "type": "string"
        },
        "position": {
          "title": "Position",
          "type": "integer"
        },
        "score": {
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "position",
        "knowledge_base_id",
        "chunk_id",
        "document_id",
        "document_name",
        "content",
        "score"
