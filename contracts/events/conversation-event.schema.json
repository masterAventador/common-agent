      "title": "MessageResponse",
      "type": "object"
    },
    "MessageRole": {
      "enum": [
        "user",
        "assistant"
      ],
      "title": "MessageRole",
      "type": "string"
    },
    "MessageStatus": {
      "enum": [
        "pending",
        "streaming",
        "completed",
        "failed",
        "stopped"
      ],
      "title": "MessageStatus",
      "type": "string"
    },
    "ToolCallEventResponse": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "format": "uuid",
          "title": "Capability Id",
          "type": "string"
        },
        "capability_name": {
          "title": "Capability Name",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error Code"
        },
        "tool_call_id": {
          "format": "uuid",
          "title": "Tool Call Id",
          "type": "string"
        }
      },
      "required": [
        "tool_call_id",
        "capability_id",
        "capability_name",
        "error_code"
      ],
      "title": "ToolCallEventResponse",
      "type": "object"
    }
