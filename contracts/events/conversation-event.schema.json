      "title": "CitationResponse",
      "type": "object"
    },
    "ConversationEventKind": {
      "enum": [
        "assistant.started",
        "assistant.delta",
        "assistant.reasoning",
        "assistant.completed",
        "assistant.failed",
        "assistant.stopped",
        "assistant.tool.started",
        "assistant.tool.completed",
        "assistant.tool.failed"
      ],
      "title": "ConversationEventKind",
      "type": "string"
    },
    "MessageResponse": {
      "additionalProperties": false,
      "properties": {
        "citations": {
          "items": {
            "$ref": "#/$defs/CitationResponse"
          },
          "title": "Citations",
          "type": "array"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "conversation_id": {
          "format": "uuid",
          "title": "Conversation Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error Code"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "model_configuration_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Configuration Id"
        },
        "model_identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Identifier"
        },
        "role": {
          "$ref": "#/$defs/MessageRole"
        },
        "sequence_number": {
          "title": "Sequence Number",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/MessageStatus"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
