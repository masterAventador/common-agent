{
  "name": "common-agent-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 18280 --strictPort",
    "build": "tsc -b && vite build",
    "contracts:check": "bash ../scripts/check-contracts.sh",
    "contracts:generate": "bash ../scripts/generate-contracts.sh",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bash ../scripts/test-platform-e2e.sh",
    "test:e2e:demo": "COMMON_AGENT_E2E_SUITE=demo-chat bash ../scripts/test-platform-e2e.sh",
    "test:e2e:workflows": "COMMON_AGENT_E2E_SUITE=workflow-designer bash ../scripts/test-platform-e2e.sh",
    "test:e2e:workflow-runs": "COMMON_AGENT_E2E_SUITE=workflow-run-ui bash ../scripts/test-platform-e2e.sh",
    "test:e2e:workflow-chat": "COMMON_AGENT_E2E_SUITE=workflow-chat-e2e bash ../scripts/test-platform-e2e.sh",
    "test:e2e:mvp": "COMMON_AGENT_E2E_SUITE=mvp-acceptance bash ../scripts/test-platform-e2e.sh",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@xyflow/react": "12.11.2",
    "antd": "^6.5.1",
    "axios": "^1.18.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
